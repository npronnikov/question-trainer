# ACP agent. The default starts the Codex ACP adapter via npx.
ACP_ENABLED=true
ACP_AGENT_COMMAND=npx
ACP_AGENT_ARGS=-y,@agentclientprotocol/codex-acp
# Optional absolute path to an authorized, working Codex CLI binary for run-local.sh.
CODEX_PATH=
ACP_WORKSPACE=/workspace
ACP_TIMEOUT=180s
ACP_MODELS=gpt-5.6-terra[high],gpt-5.6-sol[xhigh]
ACP_DEFAULT_MODEL=gpt-5.6-terra[high]

# Local accounts. Set a unique password (12+ chars) to create the first admin.
# Leave username and password both empty to skip admin creation.
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=
APP_ADMIN_EMAIL=

# Keep false on plain HTTP localhost. Production behind TLS must use true.
SESSION_COOKIE_SECURE=false

# Credentials consumed by the chosen coding agent, not by the trainer itself.
CODEX_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
